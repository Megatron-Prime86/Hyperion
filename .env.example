# Copy to backend/.env or export before running the API.
# SQLite is the zero-config default (no Docker required).
# DATABASE_URL=sqlite+aiosqlite:///./hyperion.db

DATABASE_URL=postgresql+asyncpg://hyperion:hyperion@localhost:5432/hyperion
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# mock | openai | anthropic  (mock needs no key)
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=

CORRELATION_WINDOW_MINUTES=30

# Live threat intel (each provider is skipped when its key is empty; the local feed always works offline)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
URLHAUS_API_KEY=
INTEL_CACHE_HOURS=24
INTEL_MAX_LOOKUPS=8         # live indicators per alert (protects API quotas)

# Analyst feedback loop: a pattern dismissed (or escalated) this many times, at this ratio, adjusts scores
FEEDBACK_MIN_DECISIONS=3
FEEDBACK_RATIO=0.8
FEEDBACK_FP_PENALTY=25
FEEDBACK_BOOST=10
# Max points an LLM score may differ from the rule-based baseline (bounds prompt-injection impact)
LLM_MAX_DEVIATION=40

# SLA targets in minutes per risk tier
SLA_ACK_MINUTES=critical=15,high=60,medium=240,low=1440
SLA_RESOLVE_MINUTES=critical=240,high=480,medium=1440,low=4320

# Notifications (each channel is skipped when not configured)
DASHBOARD_URL=http://localhost:3000
NOTIFY_MIN_TIER=critical
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hyperion@localhost
NOTIFY_EMAIL_TO=            # comma-separated

# Response playbooks: dry-run only unless explicitly enabled
PLAYBOOK_ENABLE_EXECUTION=false
PLAYBOOK_WEBHOOK_URL=
PLAYBOOK_PROTECTED_USERS=root,administrator,admin,system

# Alert dedup: identical alerts (same source/title/severity/entities) within this window fold into one row
DEDUP_WINDOW_MINUTES=60

# Auth. Leave blank to auto-generate at startup (values are printed once in the API log).
INGEST_API_KEY=            # sent as the X-API-Key header on /api/v1/alerts/ingest
JWT_SECRET=                # set a fixed value if you run more than one API process
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=          # analyst account is only created when this is set

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
